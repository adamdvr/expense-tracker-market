{
  "hooks": {
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/bin/notify.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PLUGIN_ROOT/.claude/bin/protect-files.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "if": "Edit(*ts) | Write(*ts)",
            "command": "jq -r '.tool_input.file_path' | xargs npx prettier --write --ignore-unknown"
          },
          {
            "type": "command",
            "if": "Edit(*ts) | Write(*ts)",
            "command": "npm run lint -- -- --fix"
          }
        ]
      }
    ]
  }
}
